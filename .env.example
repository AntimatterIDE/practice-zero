# Practice Zero demo.
# Do not add a Stedi or Bird key.

# Vercel production always indexes the marketing site.
# Set NOINDEX=true only for an emergency crawl block.
# NOINDEX=true

# Public site origin for canonical URLs, sitemap, and OG.
# Required in Vercel Production so sitemap/canonicals never use *.vercel.app.
# CANONICAL_ORIGIN=https://www.practicezero.com
#
# Dual domain (practice0.com + practicezero.com):
# 1. Vercel → Domains: attach practicezero.com, www.practicezero.com,
#    practice0.com, www.practice0.com. Primary = www.practicezero.com.
# 2. Point practice0.com DNS at Vercel (A apex + CNAME www per Vercel UI).
# 3. Redirect non-primary hosts to www.practicezero.com (Vercel UI and/or
#    middleware 301). Paths like /research/[slug] are preserved.
# 4. After go-live: Search Console properties for practice0.com + www;
#    submit only https://www.practicezero.com/sitemap.xml on the primary.

# React Bits Pro registry key for shadcn adds.
REACTBITS_LICENSE_KEY=

# --- Supabase (consultation leads + admin) ---
# Project URL from Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
# Service role key from Supabase → Settings → API (server only, never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin panel at /admin ---
# Password for /admin/login
ADMIN_PASSWORD=
# Random secret for signing the admin session cookie (16+ chars)
ADMIN_SESSION_SECRET=

# --- Optional email notify (best-effort only) ---
# Leads always save to Supabase. Email only sends when BOTH are set
# and the From domain is verified in Resend.
RESEND_API_KEY=
# Example after verifying practicezero.com in Resend:
# CONTACT_FROM_EMAIL=practice zero <hello@practicezero.com>
CONTACT_FROM_EMAIL=

# --- OpenAI (research drafts + site chatbot) ---
OPENAI_API_KEY=
# Optional overrides (defaults shown):
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
