# Practice Zero demo.
# Do not add a Stedi, Bird, OpenAI, or Supabase key.

# Vercel production always indexes the marketing site.
# Set NOINDEX=true only for an emergency crawl block.
# INDEXING_ENABLED=true forces indexing outside production (rare).
# NOINDEX=true

# Public site origin for canonical URLs, sitemap, and OG.
# CANONICAL_ORIGIN=https://www.practicezero.com

# React Bits Pro registry key for shadcn adds.
REACTBITS_LICENSE_KEY=

# Resend key for /contact consultation emails.
# Sends to paul@, robby@, dannie@, and anas@antimatterai.com.
RESEND_API_KEY=

# Optional verified sender. Defaults to Resend onboarding address.
# CONTACT_FROM_EMAIL=practice zero <hello@your-verified-domain.com>
